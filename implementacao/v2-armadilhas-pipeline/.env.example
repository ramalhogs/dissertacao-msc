# Copie para .env e preencha a chave do provider escolhido.

# PROVIDER: openrouter | openai | gemini | groq | anthropic
PROVIDER=openrouter

# MODELO (padrao: OpenRouter). Candidatos baratos com reasoning opcional:
#   deepseek/deepseek-v4-flash      (mais barato)
#   upstage/solar-pro4
#   xiaomi/mimo-v2.5-pro
#   minimax/minimax-m3
#   qwen/qwen3.6-plus
MODEL=deepseek/deepseek-v4-flash

# Chaves - preencha APENAS a do provider escolhido.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Parametros de coleta.
TEMPERATURE=0.0
MAX_TOKENS=4096
SEED=42
